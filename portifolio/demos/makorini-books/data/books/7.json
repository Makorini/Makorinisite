{"id":7,"title":"Breu e a Noite Estrelada","format":"Livros","synopsis":"Breu é um gato preto sem dono que só aparece depois que a cidade dorme. Numa noite sem nuvens, ele percebe que uma estrela sumiu do céu — justamente a que ele usava para encontrar o caminho de volta. Entre telhados, um velho farol e um campo de vaga-lumes, Breu parte para descobrir para onde vão as estrelas que se perdem.\n\nUma história curta e silenciosa sobre solidão, coragem e o hábito de olhar para cima.","author":"Makorini","status":"Concluída","visibility":"published","cover":"d9472b08-fa60-4575-9dfd-911a80b1fa24.png","favorite":0,"created_at":"2026-11-17T06:01:36.593Z","updated_at":"2026-11-17T06:01:36.593Z","release_year":2026,"featured":0,"featured_order":null,"cover_fit":"cover","cover_focus_x":50,"cover_focus_y":50,"adult":0,"external_links":[],"language":"pt-BR","can_edit":false,"owner_name":"Makorini","genres":[{"id":4,"name":"Aventura","created_by":null,"created_at":null},{"id":2,"name":"Fantasia","created_by":null,"created_at":null}],"chapters":[{"id":382,"book_id":7,"number":1,"title":"A estrela que faltava","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:01:36.594Z","updated_at":"2026-11-17T06:01:36.594Z","published_at":"2026-11-17T06:01:36.594Z","import_status":"complete","import_expected":0,"import_kind":"","page_count":0},{"id":383,"book_id":7,"number":2,"title":"O farol e a coruja","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:01:36.594Z","updated_at":"2026-11-17T06:01:36.594Z","published_at":"2026-11-17T06:01:36.594Z","import_status":"complete","import_expected":0,"import_kind":"","page_count":0},{"id":384,"book_id":7,"number":3,"title":"O campo dos vaga-lumes","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:01:36.594Z","updated_at":"2026-11-17T06:01:36.594Z","published_at":"2026-11-17T06:01:36.594Z","import_status":"compl