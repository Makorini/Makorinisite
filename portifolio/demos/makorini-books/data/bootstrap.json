a começa e ele descobre que a coisa mais bonita do jardim é ouvir Lis falar dele.\n\nUma história curta e delicada sobre pessoas que vivem em seus próprios mundos e o dia em que alguém pede para entrar.","author":"Makorini","status":"Concluída","visibility":"published","cover":"9e5c9245-6037-4c14-abe4-5ecbc337c486.png","favorite":0,"created_at":"2026-11-17T06:08:22.363Z","updated_at":"2026-11-17T06:08:22.363Z","release_year":2026,"featured":0,"featured_order":null,"cover_fit":"cover","cover_focus_x":50,"cover_focus_y":50,"adult":0,"external_links":[],"language":"pt-BR","can_edit":false,"owner_name":"Makorini","genres":[{"id":6,"name":"Cotidiano","created_by":null,"created_at":null},{"id":1,"name":"Romance","created_by":null,"created_at":null}],"chapters":[{"id":385,"book_id":8,"number":1,"title":"O reino do musgo","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:08:22.365Z","updated_at":"2026-11-17T06:08:22.365Z","published_at":"2026-11-17T06:08:22.365Z","import_status":"complete","import_expected":0,"import_kind":"","page_count":0},{"id":386,"book_id":8,"number":2,"title":"Do outro lado da grade","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:08:22.365Z","updated_at":"2026-11-17T06:08:22.365Z","published_at":"2026-11-17T06:08:22.365Z","import_status":"complete","import_expected":0,"import_kind":"","page_count":0},{"id":387,"book_id":8,"number":3,"title":"O vaso caído","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:08:22.365Z","updated_at":"2026-11-17T06:08:22.365Z","published_at":"2026-11-17T06:08:22.365Z","import_status":"complete","import_expected":0,"import_kind":"","page_count":0},{"id":388,"book_id":8,"number":4,"title":"O lugar favorito dele","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:08:22.365Z","updated_at":"2026-11-17T06:08:22.365Z","published_at":"2026-