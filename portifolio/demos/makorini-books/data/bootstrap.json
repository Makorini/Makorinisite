{"token":"","admin":false,"configured":true,"me":null,"static":true,"genres":[{"id":4,"name":"Aventura","can_edit":false},{"id":5,"name":"Comédia","can_edit":false},{"id":6,"name":"Cotidiano","can_edit":false},{"id":3,"name":"Drama","can_edit":false},{"id":8,"name":"Escolar","can_edit":false},{"id":2,"name":"Fantasia","can_edit":false},{"id":1,"name":"Romance","can_edit":false}],"books":[{"id":11,"title":"Tudo o Que Eu Não Disse","format":"Livros","synopsis":"Cris gosta de Léo desde os oito anos, desde o dia em que ele dividiu o lanche com ela no primeiro recreio. Cresceram lado a lado: colegas de sala, depois amigos, depois melhores amigos. Ela esteve em todas as vitórias e derrotas dele — e nunca disse uma palavra sobre o que sentia.\n\nQuando Léo começa a namorar, Cris entende que o sentimento sempre foi só dela. Então faz a única coisa que acha que pode fazer: se afasta, em silêncio, para aprender a viver sem ele.\n\nMas há coisas que só percebemos quando deixam de estar ao nosso lado. E há verdades que só conseguimos dizer quando não sobra mais nenhum lugar para onde correr.\n\nUm romance clichê, delicado e intenso sobre amor guardado por tempo demais.","author":"Makorini","status":"Concluída","visibility":"published","cover":"59027cd3-549f-4d72-bc24-8d9ccd893a41.png","favorite":0,"created_at":"2026-11-17T06:27:11.816Z","updated_at":"2026-11-18T20:50:01.854Z","release_year":2026,"featured":0,"featured_order":null,"cover_fit":"cover","cover_focus_x":50,"cover_focus_y":50,"adult":0,"external_links":[],"language":"pt-BR","can_edit":false,"owner_name":"Makorini","genres":[{"id":3,"name":"Drama","created_by":null,"created_at":null},{"id":1,"name":"Romance","created_by":null,"created_at":null}],"chapters":[{"id":398,"book_id":11,"number":1,"title":"O lanche dividido","visibility":"published","pdf_filename":null,"pdf_original_name":null,"created_at":"2026-11-17T06:27:11.817Z","updated_at":"2026-11-18T20:46:21.503Z","published_at":"2026-11-17T06:27:11.817Z","import_sta